# VoidBuild v2 Env - Copy to .env.local - NEVER commit .env.local

# OpenRouter - AI generation - get key at openrouter.ai/keys
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_HERE
APP_ORIGIN=http://localhost:3000

# Supabase - Auth + DB + Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# For new Supabase projects (sb_publishable_...):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# MoMo - YOUR numbers where customers send money (for manual fallback)
NEXT_PUBLIC_MOMO_MTN_NUMBER=+256774919318
NEXT_PUBLIC_MOMO_AIRTEL_NUMBER=+256750123456

# Pesapal - Serious automated payments for Uganda SMEs (MTN MoMo + Airtel + Cards, 3.5% fee)
# Get from pesapal.com/ug -> Dashboard -> API Keys
# Sandbox for testing: https://cybqa.pesapal.com (use test keys)
# Production: https://pay.pesapal.com/v3
PESAPAL_BASE_URL=https://pay.pesapal.com/v3
PESAPAL_CONSUMER_KEY=your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=your-pesapal-consumer-secret
PESAPAL_IPN_ID=your-ipn-id-from-registration
# Also add public env for client check (optional):
NEXT_PUBLIC_PESAPAL_CONSUMER_KEY=your-pesapal-consumer-key
